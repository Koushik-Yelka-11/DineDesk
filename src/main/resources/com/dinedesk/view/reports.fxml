<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.dinedesk.controller.ReportsController">

    <left>
        <VBox fx:id="sidebar"
              prefWidth="255"
              minWidth="255"
              maxWidth="255"
              styleClass="sidebar"
              spacing="10">

            <HBox alignment="CENTER_LEFT"
                  spacing="12"
                  styleClass="brand">

                <ImageView fitWidth="48"
                           fitHeight="48"
                           preserveRatio="false"
                           smooth="true">
                    <image>
                        <Image url="@../images/raghavendra-logo.png"/>
                    </image>
                </ImageView>

                <VBox spacing="2">
                    <Label text="UdupiDesk"
                           styleClass="brand-title"/>
                    <Label text="Billing System"
                           styleClass="brand-subtitle"/>
                </VBox>
            </HBox>

            <Label text="WORKSPACE"
                   style="-fx-text-fill: #94A3B8; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 12 12 4 12;"/>

            <Button text="☰   Dashboard"
                    onAction="#openDashboard"
                    styleClass="nav-button"
                    maxWidth="Infinity"/>

            <Button text="⊕   New Order"
                    onAction="#openNewOrder"
                    styleClass="nav-button"
                    maxWidth="Infinity"/>

            <Button text="?   Orders"
                    onAction="#openOrders"
                    styleClass="nav-button"
                    maxWidth="Infinity"/>

            <Button text="?   Menu"
                    onAction="#openMenu"
                    styleClass="nav-button"
                    maxWidth="Infinity"/>

            <Button text="?   Reports"
                    onAction="#openReports"
                    styleClass="nav-primary"
                    maxWidth="Infinity"/>

            <Label text="SYSTEM"
                   style="-fx-text-fill: #94A3B8; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 20 12 4 12;"/>

            <Button text="⚙   Settings"
                    onAction="#openSettings"
                    styleClass="nav-button"
                    maxWidth="Infinity"/>

            <Button text="?   Backup"
                    onAction="#openBackup"
                    styleClass="nav-button"
                    maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox styleClass="panel" spacing="5">
                <Label text="●  Local data safe"
                       style="-fx-text-fill: #07884F; -fx-font-weight: bold;"/>

                <Label text="Your database stays on this device"
                       wrapText="true"
                       style="-fx-text-fill: #94A3B8; -fx-font-size: 10px;"/>
            </VBox>

            <Label text="DineDesk POS · v1.0"
                   maxWidth="Infinity"
                   alignment="CENTER"
                   style="-fx-text-fill: #94A3B8; -fx-font-size: 10px; -fx-padding: 8 0 0 0;"/>

        </VBox>
    </left>

    <center>
        <VBox styleClass="page" spacing="22">

            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Sales Reports"
                           styleClass="page-title"/>

                    <Label text="DineDesk / Counter management"
                           styleClass="page-subtitle"/>
                </VBox>

                <Label text="●  OFFLINE READY"
                       styleClass="status-pill"/>
            </HBox>

            <HBox spacing="16">

                <VBox styleClass="stat-card"
                      HBox.hgrow="ALWAYS"
                      spacing="10">

                    <Label text="SALES TODAY"
                           styleClass="stat-caption"/>

                    <Label fx:id="salesLabel"
                           text="₹0.00"
                           styleClass="stat-value"/>

                </VBox>

                <VBox styleClass="stat-card"
                      HBox.hgrow="ALWAYS"
                      spacing="10">

                    <Label text="ORDERS TODAY"
                           styleClass="stat-caption"/>

                    <Label fx:id="ordersLabel"
                           text="0"
                           styleClass="stat-value"/>

                </VBox>

                <VBox styleClass="stat-card"
                      HBox.hgrow="ALWAYS"
                      spacing="10">

                    <Label text="REPORT DATE"
                           styleClass="stat-caption"/>

                    <Label fx:id="dateLabel"
                           text="Today"
                           styleClass="stat-value-small"/>

                </VBox>

            </HBox>

            <VBox styleClass="panel">
                <Label text="Daily sales are calculated from saved orders for the current date."
                       wrapText="true"
                       styleClass="body-copy"/>
            </VBox>

        </VBox>
    </center>

</BorderPane>