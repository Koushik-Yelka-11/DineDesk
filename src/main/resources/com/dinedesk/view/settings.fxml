<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.scene.control.*?>
        <?import javafx.scene.layout.*?>
        <?import javafx.scene.image.Image?>
        <?import javafx.scene.image.ImageView?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.dinedesk.controller.SettingsController"
            styleClass="root">

    <!-- Sidebar -->
    <left>
        <VBox fx:id="sidebar"
              prefWidth="255"
              minWidth="255"
              maxWidth="255"
              styleClass="sidebar"
              spacing="10">

            <HBox alignment="CENTER_LEFT"
                  spacing="12"
                  styleClass="brand">

                <ImageView fitWidth="48"
                           fitHeight="48"
                           preserveRatio="false"
                           smooth="true">
                    <image>
                        <Image url="@../images/raghavendra-logo.png"/>
                    </image>
                </ImageView>

                <VBox spacing="2">
                    <Label text="UdupiDesk"
                           styleClass="brand-title"/>
                    <Label text="Billing System"
                           styleClass="brand-subtitle"/>
                </VBox>
            </HBox>

            <Label text="WORKSPACE"
                   style="-fx-text-fill: #94A3B8;
                          -fx-font-size: 10px;
                          -fx-font-weight: bold;
                          -fx-padding: 12 12 4 12;"/>

            <Button text="🏠   Dashboard"
                    onAction="#openDashboard"
                    styleClass="nav-button"
                    maxWidth="Infinity"/>

            <Button text="➕   New Order"
                    onAction="#openNewOrder"
                    styleClass="nav-button"
                    maxWidth="Infinity"/>

            <Button text="🍽️   Orders"
                    onAction="#openOrders"
                    styleClass="nav-button"
                    maxWidth="Infinity"/>

            <Button text="📋   Menu"
                    onAction="#openMenu"
                    styleClass="nav-button"
                    maxWidth="Infinity"/>

            <Button text="📊   Reports"
                    onAction="#openReports"
                    styleClass="nav-button"
                    maxWidth="Infinity"/>

            <Label text="SYSTEM"
                   style="-fx-text-fill: #94A3B8;
                          -fx-font-size: 10px;
                          -fx-font-weight: bold;
                          -fx-padding: 20 12 4 12;"/>

            <Button text="🛠️   Settings"
                    onAction="#openSettings"
                    styleClass="nav-primary"
                    maxWidth="Infinity"/>

            <Button text="⇪   Backup"
                    onAction="#openBackup"
                    styleClass="nav-button"
                    maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- About button -->
            <Button fx:id="aboutButton"
                    text="About DineDesk"
                    onAction="#handleAboutDineDesk"
                    styleClass="about-button"
                    maxWidth="Infinity"/>

            <!-- Local data status -->
            <VBox styleClass="panel" spacing="5">
                <Label text="●  Local data safe"
                       style="-fx-text-fill: #07884F;
                              -fx-font-weight: bold;"/>

                <Label text="Your database stays on this device"
                       wrapText="true"
                       style="-fx-text-fill: #94A3B8;
                              -fx-font-size: 10px;"/>
            </VBox>

            <Label text="DineDesk POS · v1.0"
                   maxWidth="Infinity"
                   alignment="CENTER"
                   style="-fx-text-fill: #94A3B8;
                          -fx-font-size: 10px;
                          -fx-padding: 8 0 0 0;"/>

        </VBox>
    </left>

    <!-- Main content -->
    <center>
        <VBox styleClass="page" spacing="22">

            <!-- Page heading -->
            <VBox spacing="5">
                <Label text="SYSTEM"
                       style="-fx-text-fill: #2864F0;
                              -fx-font-size: 10px;
                              -fx-font-weight: bold;"/>

                <Label text="Settings"
                       styleClass="page-title"/>

                <Label text="Manage your DineDesk application preferences."
                       styleClass="page-subtitle"/>
            </VBox>

            <!-- Order management card -->
            <VBox styleClass="order-management-card" spacing="14">


                <HBox alignment="CENTER_LEFT" spacing="16">

                    <VBox spacing="5" HBox.hgrow="ALWAYS">

                        <Label text="Reset all orders"
                               styleClass="section-title"/>

                        <Label text="This action cannot be undone."
                               styleClass="reset-order-warning"/>

                    </VBox>

                    <Button text="Reset Orders"
                            onAction="#resetOrders"
                            styleClass="reset-orders-button"/>

                </HBox>

            </VBox>

        </VBox>
    </center>

</BorderPane>