<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.dinedesk.controller.NewOrderController"
            styleClass="root">

    <!-- SAME SIDEBAR AS DASHBOARD -->
    <left>
        <VBox fx:id="sidebar"
              prefWidth="255" minWidth="255" maxWidth="255"
              styleClass="sidebar" spacing="10">

            <HBox alignment="CENTER_LEFT"
                  spacing="12"
                  styleClass="brand">

                <ImageView fitWidth="48"
                           fitHeight="48"
                           preserveRatio="false"
                           smooth="true">
                    <image>
                        <Image url="@../images/raghavendra-logo.png"/>
                    </image>
                </ImageView>

                <VBox spacing="2">
                    <Label text="UdupiDesk"
                           styleClass="brand-title"/>
                    <Label text="Billing System"
                           styleClass="brand-subtitle"/>
                </VBox>
            </HBox>

            <Label text="WORKSPACE"
                   style="-fx-text-fill: #94A3B8; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 12 12 4 12;"/>

            <Button text="☰   Dashboard"
                    onAction="#openDashboard"
                    styleClass="nav-button"
                    maxWidth="Infinity"/>

            <Button text="⊕   New Order"
                    onAction="#openNewOrder"
                    styleClass="nav-primary"
                    maxWidth="Infinity"/>

            <Button text="?   Orders"
                    onAction="#openOrders"
                    styleClass="nav-button"
                    maxWidth="Infinity"/>

            <Button text="?   Menu"
                    onAction="#openMenu"
                    styleClass="nav-button"
                    maxWidth="Infinity"/>

            <Button text="?   Reports"
                    onAction="#openReports"
                    styleClass="nav-button"
                    maxWidth="Infinity"/>

            <Label text="SYSTEM"
                   style="-fx-text-fill: #94A3B8; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 20 12 4 12;"/>

            <Button text="⚙   Settings"
                    onAction="#openSettings"
                    styleClass="nav-button"
                    maxWidth="Infinity"/>

            <Button text="?   Backup"
                    onAction="#openBackup"
                    styleClass="nav-button"
                    maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox styleClass="panel" spacing="5">
                <Label text="●  Local data safe"
                       style="-fx-text-fill: #07884F; -fx-font-weight: bold;"/>
                <Label text="Your database stays on this device"
                       wrapText="true"
                       style="-fx-text-fill: #94A3B8; -fx-font-size: 10px;"/>
            </VBox>

            <Label text="DineDesk POS · v1.0"
                   style="-fx-text-fill: #94A3B8; -fx-font-size: 10px; -fx-alignment: CENTER; -fx-padding: 8;"/>
        </VBox>
    </left>

    <!-- NEW ORDER CONTENT -->
    <center>
        <VBox styleClass="page" spacing="24">

            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox HBox.hgrow="ALWAYS" spacing="5">
                    <Label text="NEW ORDER"
                           style="-fx-text-fill: #2864F0; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                    <Label text="Create Order" styleClass="page-title"/>
                    <Label text="Select menu items and prepare the customer's bill."
                           styleClass="page-subtitle"/>
                </VBox>

                <HBox alignment="CENTER" spacing="8"
                      style="-fx-background-color: #E8FBF1; -fx-background-radius: 20; -fx-padding: 10 14;">

                </HBox>
            </HBox>

            <HBox spacing="18" VBox.vgrow="ALWAYS">

                <!-- MENU -->
                <VBox styleClass="panel" spacing="14"
                      HBox.hgrow="ALWAYS">

                    <HBox alignment="CENTER_LEFT">
                        <Label text="Menu Items" styleClass="section-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="menuCountLabel"
                               text="0 items" styleClass="muted"/>
                    </HBox>

                    <TextField fx:id="searchField"
                               promptText="Search dishes..."/>

                    <ComboBox fx:id="categoryCombo"
                              promptText="All Categories"
                              maxWidth="Infinity"/>

                    <ListView fx:id="menuListView"
                              id="menuListView"
                              VBox.vgrow="ALWAYS"
                              minHeight="280">
                        <placeholder>
                            <Label text="No menu items found."
                                   styleClass="muted"/>
                        </placeholder>
                    </ListView>

                    <Button text="＋  Add Selected Item"
                            onAction="#addSelectedItem"
                            styleClass="primary-button"
                            maxWidth="Infinity"/>
                </VBox>

                <!-- CURRENT ORDER -->
                <VBox styleClass="panel" spacing="14"
                      prefWidth="355" minWidth="310">

                    <HBox alignment="CENTER_LEFT">
                        <Label text="Current Order" styleClass="section-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="cartCountLabel"
                               text="0 items" styleClass="muted"/>
                    </HBox>

                    <Label text="Review the items before saving the order."
                           styleClass="page-subtitle" wrapText="true"/>

                    <ListView fx:id="cartListView"
                              id="cartListView"
                              VBox.vgrow="ALWAYS"
                              prefHeight="280">
                        <placeholder>
                            <Label text="Your cart is empty."
                                   styleClass="muted"/>
                        </placeholder>
                    </ListView>

                    <HBox spacing="8">
                        <Button text="− Quantity"
                                onAction="#decreaseSelectedQuantity"
                                styleClass="secondary-button"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"/>
                        <Button text="+ Quantity"
                                onAction="#increaseSelectedQuantity"
                                styleClass="secondary-button"
                                HBox.hgrow="ALWAYS"
                                maxWidth="Infinity"/>
                    </HBox>

                    <Button text="Remove Selected Item"
                            onAction="#removeSelectedItem"
                            styleClass="secondary-button"
                            maxWidth="Infinity"/>

                    <Separator/>

                    <HBox alignment="CENTER_LEFT">
                        <Label text="Subtotal" styleClass="stat-caption"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="subtotalLabel"
                               text="₹0.00" styleClass="body-copy"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT">
                        <Label text="TOTAL" styleClass="total-caption"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="totalLabel"
                               text="₹0.00" styleClass="total-value"/>
                    </HBox>

                    <Button text="Clear Order"
                            onAction="#clearOrder"
                            styleClass="secondary-button"
                            maxWidth="Infinity"/>

                    <Button text="Save Order"
                            onAction="#saveOrder"
                            styleClass="primary-button"
                            maxWidth="Infinity"/>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
