<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="dinedesk.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="2138"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="DineDesk_100_Menu_Items" custom_title="0" dock_id="2" table="4,23:mainDineDesk_100_Menu_Items"/><dock_state state="000000ff00000000fd00000001000000020000000000000000fc0100000002fb000000160064006f0063006b00420072006f00770073006500310100000000ffffffff0000000000000000fb000000160064006f0063006b00420072006f00770073006500320100000000ffffffff0000010100ffffff000000000000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings/></tab_browse><tab_sql><sql name="SQL 1*">-- DineDesk: import the 100 menu items from MENU_PRICES.pdf
-- Run this script against the DineDesk SQLite database.
-- Existing menu items are preserved; exact category/name duplicates are skipped.
-- All rice and Chinese dishes are stored under one category: 'Rice Items &amp; Chinese'.
PRAGMA foreign_keys = ON;
BEGIN IMMEDIATE;

-- Create any menu categories that do not already exist.
INSERT OR IGNORE INTO categories (name) VALUES ('Rice Items &amp; Chinese');
INSERT OR IGNORE INTO categories (name) VALUES ('Dosa Items');
INSERT OR IGNORE INTO categories (name) VALUES ('Meals');
INSERT OR IGNORE INTO categories (name) VALUES ('Rotis');
INSERT OR IGNORE INTO categories (name) VALUES ('Sweets &amp; Snacks');
INSERT OR IGNORE INTO categories (name) VALUES ('Tiffins');

-- Move any previously imported Rice Items / Chinese dishes into the combined category.
-- Remove an old-category row first if the same dish already exists in the combined category.
DELETE FROM menu_items
WHERE category_id IN (SELECT id FROM categories WHERE name IN ('Rice Items', 'Chinese'))
  AND EXISTS (
      SELECT 1 FROM menu_items AS combined
      WHERE combined.category_id = (SELECT id FROM categories WHERE name = 'Rice Items &amp; Chinese')
        AND combined.name = menu_items.name
  );

UPDATE menu_items
SET category_id = (SELECT id FROM categories WHERE name = 'Rice Items &amp; Chinese')
WHERE category_id IN (SELECT id FROM categories WHERE name IN ('Rice Items', 'Chinese'));

-- Remove the old categories after their items have been moved.
DELETE FROM categories
WHERE name IN ('Rice Items', 'Chinese')
  AND NOT EXISTS (
      SELECT 1 FROM menu_items
      WHERE menu_items.category_id = categories.id
  );
-- Insert menu items without duplicating an existing item in the same category.
INSERT INTO menu_items (category_id, name, price) SELECT id, 'Idly (2 pcs)', 50 FROM categories WHERE name = 'Tiffins' AND NOT EXISTS (SELECT 1 FROM menu_items WHERE category_id = categories.id AND name = 'Idly (2 pcs)');
